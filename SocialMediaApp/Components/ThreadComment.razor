@using SocialMediaApp.Data
@using SocialMediaApp.Services

<article class="border-start border-3 ps-3 py-2 mb-2" style="margin-left: @(Math.Min(Depth, 6))rem;" @key="Comment.Id">
    <p class="small text-muted mb-1">@(Comment.User.UserName ?? "User") · @Comment.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</p>
    <p style="white-space: pre-wrap; overflow-wrap: anywhere;">@Comment.Content</p>
    @{ var like = Likes.GetValueOrDefault(Comment.Id, new LikeSummary(0, false)); }
    <button type="button" class="btn btn-sm @(like.IsLikedByCurrentUser ? "btn-primary" : "btn-outline-primary") me-2"
            disabled="@Disabled" @onclick="() => OnToggleLike.InvokeAsync(Comment)">
        @(like.IsLikedByCurrentUser ? "Unlike" : "Like") (@like.Count)
    </button>
    <button type="button" class="btn btn-sm btn-outline-primary" disabled="@Disabled"
            @onclick="() => OnReply.InvokeAsync(Comment)">Reply</button>
</article>
@foreach (var reply in Comments.Where(c => c.ParentCommentId == Comment.Id))
{
    <ThreadComment @key="reply.Id" Comment="reply" Comments="Comments" Likes="Likes" Depth="@(Depth + 1)"
                   OnReply="OnReply" OnToggleLike="OnToggleLike" Disabled="Disabled" />
}

@code {
    [Parameter, EditorRequired] public Comment Comment { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<Comment> Comments { get; set; } = Array.Empty<Comment>();
    [Parameter, EditorRequired] public IReadOnlyDictionary<int, LikeSummary> Likes { get; set; } = new Dictionary<int, LikeSummary>();
    [Parameter] public int Depth { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<Comment> OnReply { get; set; }
    [Parameter] public EventCallback<Comment> OnToggleLike { get; set; }
}
