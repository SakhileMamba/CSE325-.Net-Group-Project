@using System.Globalization
@using SocialMediaApp.Data
@using SocialMediaApp.Services
@inject LikeService LikeService
@inject ILogger<PostCard> Logger

<article class="post">
    @if (!string.IsNullOrEmpty(Post.User.ProfilePicture))
    {
        <img class="avatar" src="@Post.User.ProfilePicture" alt="" />
    }
    else
    {
        <div class="avatar avatar-initial" aria-hidden="true">@DisplayName[..1].ToUpperInvariant()</div>
    }
    <div class="post-body">
        <div>
            <a class="post-author" href="@($"profile/{Uri.EscapeDataString(Post.User.UserName ?? "")}")">@DisplayName</a>
            <span class="text-muted">·</span>
            <a class="post-time" href="@($"posts/{Post.Id}")"
               title="@($"{Post.CreatedAtUtc:yyyy-MM-dd HH:mm} UTC")">@TimeAgo(Post.CreatedAtUtc)</a>
        </div>
        <p class="post-content">@Post.Content</p>
        <button type="button" class="btn btn-sm @(postLike.IsLikedByCurrentUser ? "btn-primary" : "btn-outline-primary") mb-2"
                disabled="@busy" @onclick="ToggleLikeAsync">
            @(postLike.IsLikedByCurrentUser ? "Unlike" : "Like") (@postLike.Count)
        </button>
        <PostReplies PostId="Post.Id" />
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Post Post { get; set; } = null!;
    private LikeSummary postLike = new(0, false);
    private bool busy;

    protected override async Task OnParametersSetAsync()
    {
        try { postLike = await LikeService.GetPostLikeAsync(Post.Id) ?? new(0, false); }
        catch (Exception ex) { Logger.LogError(ex, "Loading likes failed for post {PostId}.", Post.Id); }
    }

    private async Task ToggleLikeAsync()
    {
        if (busy) return;
        busy = true;
        try { postLike = await LikeService.TogglePostLikeAsync(Post.Id) ?? new(0, false); }
        catch (Exception ex) { Logger.LogError(ex, "Updating like failed for post {PostId}.", Post.Id); }
        finally { busy = false; }
    }

    private string DisplayName
    {
        get
        {
            var fullName = $"{Post.User.FirstName} {Post.User.LastName}".Trim();
            return fullName.Length > 0 ? fullName : Post.User.UserName ?? "User";
        }
    }

    // "now", "5m", "3h", then the date
    private static string TimeAgo(DateTime createdAtUtc)
    {
        var age = DateTime.UtcNow - createdAtUtc;
        if (age.TotalMinutes < 1) return "now";
        if (age.TotalHours < 1) return $"{(int)age.TotalMinutes}m";
        if (age.TotalDays < 1) return $"{(int)age.TotalHours}h";
        var format = createdAtUtc.Year == DateTime.UtcNow.Year ? "MMM d" : "MMM d, yyyy";
        return createdAtUtc.ToString(format, CultureInfo.InvariantCulture);
    }
}
