@page "/profile/{Username}"
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using SocialMediaApp.Data

@inject UserManager<ApplicationUser> UserManager
@inject IDbContextFactory<ApplicationDbContext> ContextFactory

<PageTitle>Profile</PageTitle>

@if (loading)
{
    <p>Loading profile...</p>
}
else if (user is null)
{
    <div class="alert alert-warning">
        Profile not found.
    </div>
}
else
{
    <div class="text-center mb-4">
        @if (!string.IsNullOrEmpty(user.ProfilePicture))
        {
            <img src="@user.ProfilePicture"
                 alt="Profile picture"
                 style="width: 140px; height: 140px; object-fit: cover; border-radius: 50%;" />
        }
        else
        {
            <div style="width: 140px; height: 140px; border-radius: 50%; background-color: #e9ecef; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                <span class="text-muted">No photo</span>
            </div>
        }

        <h1 class="mt-3">
            @user.FirstName @user.LastName
        </h1>

        <p class="text-muted">@("@")@Username</p>

        @if (!string.IsNullOrWhiteSpace(user.Bio))
        {
            <p>@user.Bio</p>
        }

        @if (!string.IsNullOrWhiteSpace(user.Interests))
        {
            <p>
                <strong>Interests:</strong> @user.Interests
            </p>
        }
    </div>

    <hr />

    <h2>Posts</h2>

    @if (posts.Count == 0)
    {
        <p class="text-muted">This user has no posts yet.</p>
    }
    else
    {
        @foreach (var post in posts)
        {
            <article class="card mb-3" @key="post.Id">
                <div class="card-body">
                    <p class="card-text"
                       style="white-space: pre-wrap; overflow-wrap: anywhere;">
                        @post.Content
                    </p>

                    <p class="text-muted small">
                        @post.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC
                    </p>

                    <a class="btn btn-link px-0"
                       href="@($"/posts/{post.Id}")">
                        Comments &amp; replies
                    </a>
                </div>
            </article>
        }
    }
}

@code {
    [Parameter]
    public string Username { get; set; } = "";

    private ApplicationUser? user;
    private List<Post> posts = new();
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        user = null;
        posts = new();

        user = await UserManager.FindByNameAsync(Username);

        if (user is not null)
        {
            await using var db = await ContextFactory.CreateDbContextAsync();

            posts = await db.Posts
                .AsNoTracking()
                .Where(post => post.UserId == user.Id)
                .OrderByDescending(post => post.CreatedAtUtc)
                .ThenByDescending(post => post.Id)
                .ToListAsync();
        }

        loading = false;
    }
}