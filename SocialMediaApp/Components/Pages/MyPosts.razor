@page "/my-posts"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.ComponentModel.DataAnnotations
@using SocialMediaApp.Data
@using SocialMediaApp.Services
@inject PostService PostService
@inject ILogger<MyPosts> Logger

<PageTitle>My Posts</PageTitle>
<div class="feed">
<h1 class="feed-header">My Posts</h1>

@if (message is not null)
{
    <div class="alert alert-info m-3" role="status">@message</div>
}

<EditForm Model="input" OnValidSubmit="SaveAsync" FormName="post-editor" class="composer">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" role="alert" />
    <label for="post-content" class="visually-hidden">@(editingId is null ? "Create a post" : "Edit your post")</label>
    <InputTextArea id="post-content" class="form-control" @bind-Value="input.Content" maxlength="250" rows="3"
                   placeholder="@(editingId is null ? "What's happening?" : "Update your post")" disabled="@busy" />
    <div class="composer-footer">
        <span class="form-text">Maximum 250 characters.</span>
        <div>
            @if (editingId is not null)
            {
                <button type="button" class="btn btn-link" @onclick="CancelEdit" disabled="@busy">Cancel</button>
            }
            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold" disabled="@busy">@(editingId is null ? "Post" : "Save")</button>
        </div>
    </div>
</EditForm>

@if (posts is null)
{
    <p class="text-muted p-3" role="status">Loading posts...</p>
}
else if (posts.Count == 0)
{
    <p class="text-muted p-3" role="status">You have no posts yet.</p>
}
else
{
    @foreach (var post in posts)
    {
        <article class="post" @key="post.Id">
            @if (!string.IsNullOrEmpty(post.User.ProfilePicture))
            {
                <img class="avatar" src="@post.User.ProfilePicture" alt="" />
            }
            else
            {
                <div class="avatar avatar-initial" aria-hidden="true">@DisplayName(post)[..1].ToUpperInvariant()</div>
            }
            <div class="post-body">
                <div><span class="post-author">@DisplayName(post)</span> <span class="text-muted">· @post.CreatedAtUtc.ToString("MMM d")</span></div>
                <p class="post-content">@post.Content</p>
                @if (deletingId == post.Id)
                {
                    <p class="text-danger small mb-2" role="alert">Delete this post?</p>
                    <button class="btn btn-sm btn-danger rounded-pill" @onclick="() => DeleteAsync(post.Id)" disabled="@busy">Confirm delete</button>
                    <button class="btn btn-sm btn-link" @onclick="() => deletingId = null" disabled="@busy">Cancel</button>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-primary rounded-pill" @onclick="() => StartEdit(post)" disabled="@busy">Edit</button>
                    <button class="btn btn-sm btn-outline-danger rounded-pill ms-2" @onclick="() => deletingId = post.Id" disabled="@busy">Delete</button>
                }
                <div class="mt-2">
                    <PostReplies PostId="post.Id" />
                </div>
            </div>
        </article>
    }
}
</div>

@code {
    private List<Post>? posts;
    private PostInput input = new();
    private int? editingId;
    private int? deletingId;
    private bool busy;
    private string? message;

    private static string DisplayName(Post post)
    {
        var fullName = $"{post.User.FirstName} {post.User.LastName}".Trim();
        return fullName.Length > 0 ? fullName : post.User.UserName ?? "User";
    }

    protected override async Task OnInitializedAsync()
        => await RunAsync(async () => posts = await PostService.GetMyPostsAsync());

    private void StartEdit(Post post)
    {
        editingId = post.Id;
        deletingId = null;
        input = new PostInput { Content = post.Content };
        message = null;
    }

    private void CancelEdit()
    {
        editingId = null;
        input = new();
    }

    private Task SaveAsync() => RunAsync(async () =>
    {
        if (editingId is int id)
        {
            if (!await PostService.UpdateAsync(id, input.Content))
            {
                message = "This post is unavailable or does not belong to you.";
                return;
            }
            message = "Post updated.";
        }
        else
        {
            await PostService.CreateAsync(input.Content);
            message = "Post created.";
        }
        CancelEdit();
        posts = await PostService.GetMyPostsAsync();
    });

    private Task DeleteAsync(int id) => RunAsync(async () =>
    {
        message = await PostService.DeleteAsync(id)
            ? "Post deleted." : "This post is unavailable or does not belong to you.";
        deletingId = null;
        if (editingId == id) CancelEdit();
        posts = await PostService.GetMyPostsAsync();
    });

    private async Task RunAsync(Func<Task> action)
    {
        if (busy) return;
        busy = true;
        message = null;
        try { await action(); }
        catch (ValidationException ex) { message = ex.Message; }
        catch (UnauthorizedAccessException ex) { message = ex.Message; }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Post management operation failed.");
            message = "Unable to complete the operation. Please try again.";
        }
        finally { busy = false; }
    }

    private sealed class PostInput
    {
        [Required(ErrorMessage = "Please enter post content.")]
        [StringLength(250, ErrorMessage = "Posts cannot exceed 250 characters.")]
        public string Content { get; set; } = "";
    }
}
